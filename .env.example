# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK credentials — used by the /api/notify serverless function.
# Add this as an environment variable in your Vercel / Netlify project dashboard.
# NEVER commit real values to git.
# ─────────────────────────────────────────────────────────────────────────────

# Paste the entire contents of the service account JSON file as a single value.
# Firebase Console → Project Settings → Service accounts → Generate new private key
#
# Example (paste your actual JSON, all on one line or multi-line depending on host):
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"123","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
